# Sao chép thành .env rồi điền giá trị (không đưa .env lên GitHub)

# Client ID của OAuth client loại "Chrome extension" (Google Cloud Console)
GOOGLE_CLIENT_ID=566995321513-07cpp9a2gv8m2lmat8mc0vmm3br4aluk.apps.googleusercontent.com

# Chuỗi bí mật ngẫu nhiên >= 32 ký tự, dùng để ký phiên đăng nhập.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=327550423f5e3103fc93bfbfa04cb1c073f7e812d4d1e6890bc5effec8bf8860

# Tuỳ chọn
PORT=3000
DB_PATH=./data/app.db
SESSION_DAYS=30
# Số lượt tặng khi người dùng đăng nhập lần đầu
FREE_CREDITS=20

# Khu vực tạm thời không phục vụ (mã quốc gia ISO, cách nhau bằng dấu phẩy).
# Bỏ dòng này để dùng mặc định: EEA, Thụy Sĩ (CH), Anh (GB). Để trống (BLOCKED_COUNTRIES=) để tắt chặn.
# BLOCKED_COUNTRIES=
# Header chứa mã quốc gia của người gọi (mặc định của Cloudflare)
# COUNTRY_HEADER=cf-ipcountry

# Tạo Gemini key tự động cho từng user trong một dự án Google Cloud cố định (bỏ trống thì tắt tính năng).
# Cần: bật "API Keys API" và "Generative Language API" trong dự án; service account có vai trò
# "API Keys Admin" (roles/serviceusage.apiKeysAdmin).
GCP_PROJECT_ID=gen-lang-client-0412444896
# Nội dung file khoá JSON của service account (dán nguyên JSON một dòng hoặc dạng base64)...
# GCP_SA_JSON=
# ...hoặc đường dẫn tới file đó (chọn một trong hai)
GCP_SA_FILE=./secrets/service-account.json

ADMIN_TOKEN=01756089

